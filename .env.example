# Copy to .env and fill in. Everything is optional; the app still works offline without keys.

# ---- AI (pick one) ----
# Option A: Kiro (uses your Kiro subscription via Kiro CLI headless mode).
#   1. Install Kiro CLI: https://kiro.dev/cli
#   2. Create an API key in your Kiro account settings (Pro / Pro+ / Power plans)
KIRO_API_KEY=
# Or skip the key, run `kiro-cli login` once, and set AI_PROVIDER=kiro
# AI_PROVIDER=kiro
# KIRO_CLI_PATH=kiro-cli

# Option B: direct model API keys (Gemini keys: https://aistudio.google.com/apikey)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Add as many as you like: every connected provider's models show up in the model picker in ask.
# Optional default model for new devices, as provider:model (e.g. kiro:claude-opus-4.8, gemini:gemini-2.5-pro)
AI_MODEL=
# Optional: point OpenAI at any compatible service (OpenRouter, Ollama, LM Studio…)
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# ---- Spotify ----
# Create an app at https://developer.spotify.com/dashboard
# Add redirect URI: http://127.0.0.1:3000/callback
SPOTIFY_CLIENT_ID=

PORT=3000
