# Copy to .env and fill in. Everything is optional; the app still works offline without keys.

# AI (pick one). Unlocks smart syllabus parsing, chat, and notes generation.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model override (defaults: claude-sonnet-4-5 / gpt-4o-mini)
AI_MODEL=

# Spotify: create an app at https://developer.spotify.com/dashboard
# Add redirect URI: http://127.0.0.1:3000/callback
SPOTIFY_CLIENT_ID=

PORT=3000
